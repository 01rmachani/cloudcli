# Copy this file to .env and adjust values for local development
# .env is gitignored — never commit real credentials

# OAuth2 proxy headers
# In production these come from your ingress/OAuth2 proxy as HTTP headers.
# For local dev, set them here to simulate a logged-in user.
X_AUTH_REQUEST_USER=admin
X_AUTH_REQUEST_EMAIL=admin@example.com

# SQLite database path inside the container
DATABASE_PATH=/root/.cloudcli/auth.db

# CloudCLI platform mode (true = multi-user, false = single-user)
VITE_IS_PLATFORM=true
